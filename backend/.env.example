# Anthropic API
ANTHROPIC_API_KEY=your_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wvf_content_engine

# Environment
ENVIRONMENT=development

# X (Twitter) OAuth — from the X Developer Portal app's "Keys and tokens"
# tab (OAuth 2.0 Client ID and Client Secret). App type must be "Web App,
# Automated App or Bot" — "Native App" won't issue a Client Secret.
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

# This backend's own public base URL — used to build the OAuth callback
# (BACKEND_URL + /api/oauth/x/callback), which must exactly match the
# Callback URI registered in the X Developer Portal app's User
# authentication settings. Railway: your Railway service's public domain.
BACKEND_URL=http://localhost:8000

# The frontend's public base URL — only used to redirect the browser back
# after the OAuth callback finishes. Vercel: your Vercel deployment domain.
FRONTEND_URL=http://localhost:3000

# Fernet key encrypting stored OAuth access/refresh tokens at rest (X,
# Instagram, Facebook all share this one key). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every already-stored token unrecoverable —
# reconnecting the account is the only recovery path.
TOKEN_ENCRYPTION_KEY=your_fernet_key

# Meta (Instagram + Facebook) OAuth — from a Meta Developer app's "Facebook
# Login for Business" product settings. One app covers both platforms.
# Connecting an account works with just these two vars set; actually
# publishing needs `pages_manage_posts` + `instagram_content_publish`,
# which Meta only grants after App Review — a manual approval process on
# Meta's side, separate from anything in this codebase.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Redirect URI to register in the Meta app's Facebook Login settings:
# {BACKEND_URL}/api/oauth/meta/callback (uses the same BACKEND_URL/
# FRONTEND_URL above as the X integration).

# Shared secret protecting POST /api/social/x/run-scheduled-posts — the
# scheduled auto-posting endpoint, called periodically by an external
# scheduler (Railway Cron Job), not by staff or the frontend. Without
# this set, that endpoint is disabled (503) rather than open to anyone
# who finds the URL, since it can publish real content to WVF's
# connected X account. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value in the Railway Cron Job's request headers
# (X-Scheduler-Secret) so it can actually call this endpoint.
SCHEDULER_SECRET=your_scheduler_secret

# Gmail/Google Workspace SMTP for the approver "forgot passcode" reset
# email only (see app/routers/approvers.py) — one transactional email
# per reset request, not bulk/marketing sending. SMTP_USERNAME is the
# sending account's address; SMTP_APP_PASSWORD is an app-specific
# password generated at myaccount.google.com/apppasswords (requires
# 2FA enabled on that account — a normal account password won't work
# here). Without these set, forgot-passcode requests fail silently
# (logged, not surfaced to the caller) — see forgot_passcode's docstring
# for why it never reveals send failures in its response.
SMTP_USERNAME=your_sending_account@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password

# Cloudflare R2 (S3-compatible object storage) — backs the staff photo
# library and AI-generated images (see app/services/object_storage.py).
# Uploads go browser -> R2 directly via a presigned URL; this backend
# never touches file bytes. R2_ACCOUNT_ID/ACCESS_KEY_ID/SECRET_ACCESS_KEY
# come from the Cloudflare dashboard's R2 > Manage R2 API Tokens.
# R2_BUCKET_NAME is the bucket you create there. R2_PUBLIC_BASE_URL is
# that bucket's public read URL (its r2.dev subdomain, or a custom
# domain if one's connected) — the bucket must have public access
# enabled, since photos/generated images aren't sensitive data.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_BASE_URL=https://your-bucket.r2.dev

# Google AI Studio / Vertex AI — powers AI image generation (see
# app/services/image_generation.py). IMAGE_GEN_MODEL is swappable, not
# hardcoded to one model — defaults to Imagen 4 Fast (~$0.02/image) if unset.
IMAGE_GEN_API_KEY=your_google_ai_api_key
IMAGE_GEN_MODEL=imagen-4-fast
